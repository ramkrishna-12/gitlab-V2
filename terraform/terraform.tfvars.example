# Copy to terraform.tfvars (git-ignored) and edit.
region              = "ap-south-1"
ssh_public_key_path = "~/.ssh/id_ed25519.pub"

# First apply: your public IP (curl -4 ifconfig.me) so you can reach vpn-gw once.
# After the admin VPN profile works, set this to "" and apply again.
bootstrap_ssh_cidr = "203.0.113.7/32"
